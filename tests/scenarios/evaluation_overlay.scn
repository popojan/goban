# config: mock-eval.json
#
# The live evaluation overlay (ADR-0007), end to end: it starts lazily, it
# follows the *review cursor* rather than the game position, and its numbers are
# in Black's frame of reference whoever is to move.
#
# The bot list is the shape the ADR is about: one engine entry carrying both
# "main" and "kibitz", whose playing instance is started with --no-analyze and
# whose analysis instance inherits the same command with analysis_parameters
# applied. Two processes from one configuration — which is the decision.
#
#   ./tests/run_scenarios.sh tests/scenarios/evaluation_overlay.scn

new_game 9
wait_idle
expect board_size 9

# Both sides human. The default assignment puts the mock on White, and an engine
# that answers every move would advance the position past the one being asserted
# on — the colour to move is the whole point here.
switch_player white Human
wait_idle
expect white_player Human

# Off by default, and nothing has been spawned. `can_evaluation` says an engine
# nominated itself; `eval_state` says nothing is running yet.
expect can_evaluation true
expect eval_enabled false
expect eval_state disabled

# Enabling is what starts the process — the second set of weights is never
# loaded during startup, which is the one window where the renderer and an
# engine reliably contend.
toggle_evaluation on
expect eval_enabled true
wait_until eval_state running

# Black is to move on an empty board, and the mock reports 0.6 for the side to
# move. Asserting 60 here and 40 below is the whole frame-of-reference rule:
# raw numbers would read 60 both times and flip the bar every move.
wait_until eval_winrate 60
expect eval_has_score true
expect eval_stale false

# The board stays clean. This is the case most worth pinning: the panel is on
# and reporting, and the engine's suggestions are *not* drawn, because the two
# are separate features and this one is off by default. The numbers are read
# after a move so a player can invent their own and judge it; stars on the board
# are read before, and would take that choice away from the first move.
expect eval_moves_shown false
expect eval_labels 0

# Asked for explicitly, the suggestions appear. The mock proposes the first two
# empty points in scan order, so the count is deterministic.
toggle_evaluation_moves on
expect eval_moves_shown true
wait_until eval_labels 2

expect eval_tints 0

toggle_evaluation_moves off
wait_until eval_labels 0
expect eval_moves_shown false

# A move makes it White's turn, so the same engine report must now display as
# Black 40%. This is also the first position change, so it exercises the
# incremental sync: one `play`, not a replay.
click 2 2
click 2 2
wait_idle
wait_until eval_winrate 40
expect move_count 1

click 4 4
click 4 4
wait_idle
wait_until eval_winrate 60
expect move_count 2

# The point of a separate process: navigating back re-analyses the position
# under the cursor, rather than leaving the overlay describing the end of the
# game. After one step back it is White to move again.
navigate_back
wait_idle
expect view_position 1
wait_until eval_winrate 40
expect eval_stale false

navigate_end
wait_idle
expect at_end true
wait_until eval_winrate 60

# The combine rule, which needs a suggestion and a recorded move on the same
# point. The mock always proposes the first two empty points in scan order — A1
# and B1 — so the game has to be played *there* for them to meet; the moves
# above are at other points on purpose, to cover the ordinary no-collision case.
new_game 9
wait_idle
switch_player white Human
wait_idle
toggle_evaluation_moves on

click 0 0
click 0 0
wait_until move_count >= 1

# Back at the root, A1 is now both the recorded continuation and the engine's
# first choice. It must be tinted, not relabelled: the record's own "1" stays and
# only takes on colour. B1 has no label of its own, so it gets one.
navigate_start
wait_idle
expect view_position 0
expect variations 1
wait_until eval_tints 1
expect eval_labels 1

toggle_evaluation_moves off
wait_until eval_labels 0
expect eval_tints 0

# Switching it off stops the process and takes the numbers away entirely. Absent
# rather than a placeholder: eval_winrate reads -1, because a bar resting at 50%
# cannot be told from a genuine even game.
toggle_evaluation off
wait_until eval_state disabled
expect eval_enabled false
expect eval_winrate -1

# The diegetic readout: the same numbers on the board's near edge instead of in
# the panel. One readout in one place — turning it on takes the panel away
# rather than saying the same thing twice.
toggle_evaluation on
wait_until eval_state running
wait_until eval_winrate 60
expect eval_on_board false

toggle_evaluation_board on
expect eval_on_board true
expect eval_winrate 60

# The composed text, which is the only part of the board readout a headless run
# can check — the glyphs themselves are never drawn here. Black leads at 60%,
# and the mock reports a 2.5 point lead for the side to move, who is Black.
wait_until eval_board_text B 60% B+2.5

toggle_evaluation_board off
expect eval_on_board false
# wait_until, not expect: this key reports what was last *drawn*, so it needs a
# frame to catch up — same as eval_labels.
wait_until eval_board_text ""
