# The game lifecycle, walked end to end through the real application.
#
# Step 1 of docs/adr/0002-explicit-game-state.md adds `phase`, derived from the
# `started` / `isGameOver` pair. This scenario asserts the derived value and the
# two raw flags together at every transition, so that when step 2 inverts the
# relationship — phase authoritative, flags derived — any disagreement between
# them shows up here rather than as a behaviour change in the field.
#
# Both players are human and every move is a pass, so nothing advances on its
# own and no assertion has to race the genmove loop.

new_game 9
wait_idle
switch_player black human
switch_player white human
wait_idle

# Setup: a fresh, empty record. Both flags clear.
expect phase setup
expect started false
expect game_over false
expect move_count 0

# Playing: the first move starts the game.
pass
wait_until move_count >= 1
wait_idle
expect phase playing
expect started true
expect game_over false

# Finished: two passes in a row end it.
pass
wait_until game_over true
wait_idle
expect phase finished
expect move_count 2
expect has_result true

# Start is refused on a finished game — the phase must not move.
start
wait_idle
expect phase finished

# Paused: navigating away from the end of a finished game resumes review.
navigate_back
wait_idle
expect phase paused
expect started false
expect game_over false
expect view_position 1

# Back to the end of a finished game restores Finished, because the user has
# not pressed Start.
navigate_end
wait_idle
expect phase finished
expect at_end true

# Paused at the root. move_count is 0 here, exactly as in Setup, so the record —
# not the view position — is what separates the two.
navigate_start
wait_idle
expect phase paused
expect move_count 0
expect main_line_moves 2

# Playing again: Start is accepted once the game is no longer over.
start
wait_idle
expect phase playing
expect started true

# Setup: a new game discards the record.
new_game 9
wait_idle
expect phase setup
expect main_line_moves 0

# Finished straight out of a load: the SGF ends in a double pass.
load_sgf tests/data/double_pass.sgf
wait_idle
expect phase finished
expect game_over true
expect started false
expect at_end true

navigate_start
wait_idle
expect phase paused
