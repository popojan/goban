# The prisoner counts, after they moved off RmlUi and onto the board.
#
# They had been in three places at once: two labels in a menu, two hidden corner
# elements that `syncPrisonerLabels()` still wrote to every frame (base.rcss said
# "prisoner counts hidden (now in Analyze menu)" and never deleted them), and the
# stones in the bowls. Only the bowls were on the board — and only two of the six
# shipped shaders draw bowls at all, so on the other four the captures were
# invisible.
#
# Three things are pinned here, and each was a decision:
#
#   1. `prisoner_shown` follows the *shader*, through PrisonerMode::Auto. Red
#      Carpet already shows the pile, so a number beside it would be the same
#      fact twice; the Minimal scenes show nothing, so the number is what there
#      is. `"bowls": 1` is declared in the shader's config entry, never inferred
#      from its GLSL — ADR-0011's rule.
#   2. Both counts are drawn whenever they are drawn at all — a zero included.
#      An earlier version hid a nought, citing ADR-0007's "absent is not zero".
#      That principle is about an estimate nobody has computed; a prisoner count
#      of zero is known, exact and unambiguous. Hiding it made `always` show an
#      empty margin, which is a control disagreeing with its own name, and it
#      left a lone digit with nothing to contrast against — the colour
#      convention is only legible as a pair.
#   3. They follow the cursor. Navigating back before the capture returns them
#      to nought, because the board is rebuilt per position.
#
# `prisoner_text_*` is what the glyph pass actually composed, not what the Board
# counted — the same distinction as `prisoners_drawn_*` and `sounds_played`, and
# the reason those two keys exist at all.
#
# Run:
#   ./tests/run_scenarios.sh tests/scenarios/prisoners_on_the_margin.scn

new_game 9
wait_idle
switch_player black human
switch_player white human
wait_idle

# Shader 0 is Red Carpet, which carries "bowls": 1.
expect prisoner_mode auto
expect prisoner_shown false

# `always` means always, and on an empty board that has to mean 0 and 0 — this
# is the case that made the hiding rule untenable. Nothing has been captured and
# the shader has bowls, and the counts appear regardless, immediately.
#
# Driven through the *widget*, not the command: a select's chosen value does not
# reach its command by itself, and this select shipped without the branch in
# EventHandlerNewGame that lifts it out of the change event. `prisoners always`
# worked and picking "always" from the menu did not — it ran the bare command,
# which reports the setting rather than changing it. Nothing else in the suite
# exercises a widget, so nothing else could have caught it.
menu_select selectPrisoners always
wait_idle
expect prisoner_mode always
expect prisoner_shown true
wait_until prisoner_text_white 0
expect prisoner_text_black 0
menu_select selectPrisoners auto
wait_idle
expect prisoner_mode auto
expect prisoner_shown false

# Black B1, White A1, Black A2 — Black takes the corner stone. Same capture as
# board_click_stone_in_hand.scn, and the colours fall out of the move order.
click 1 0
click 1 0
wait_until move_count >= 1
click 0 0
click 0 0
wait_until move_count >= 2
click 0 1
click 0 1
wait_until move_count >= 3
expect captured_white 1
expect captured_black 0

# A white stone was taken, but this shader has bowls, so nothing is written.
expect prisoner_text_white ""
expect prisoner_text_black ""

# One step along the list is Minimal Thin: no bowls, so Auto starts drawing.
# wait_until rather than expect — a shader change is a link, and the count is
# composed by the glyph pass on a later frame.
cycle shaders
wait_idle
expect prisoner_shown true
wait_until prisoner_text_white 1
# And its partner, at nought. Black has taken nothing, but the zero is drawn:
# one number alone cannot show which colour means what.
expect prisoner_text_black 0

# They follow the cursor: back before the capture the count returns to nought,
# and it is drawn as a nought rather than vanishing.
navigate_back
wait_idle
expect captured_white 0
wait_until prisoner_text_white 0
expect prisoner_text_black 0
navigate_forward
wait_idle
wait_until prisoner_text_white 1
expect prisoner_text_black 0

# `never` silences it on a shader that has nothing else to show. `always` puts it
# back even where the bowls already say it — both are the user's call, which is
# why Auto is a default rather than the only behaviour.
prisoners never
wait_idle
expect prisoner_mode never
expect prisoner_shown false
wait_until prisoner_text_white ""

prisoners always
wait_idle
expect prisoner_mode always
expect prisoner_shown true
wait_until prisoner_text_white 1

# Always means always, bowls included: back on Red Carpet the number stays.
cycle shaders
cycle shaders
cycle shaders
cycle shaders
cycle shaders
wait_idle
expect prisoner_shown true
wait_until prisoner_text_white 1

prisoners auto
wait_idle
expect prisoner_shown false
