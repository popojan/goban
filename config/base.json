    "distance": 3.1,
    "pan": {
      "x": 0.0,
      "y": -0.2
    },
    "rotation": {
      "w": 0.0,
      "x": -0.9,
      "y": 0.5,
      "z": 0.0
    }
  },
  "bots": [
    {
      "name": "GNU Go 3.8",
      "path": "./engine/gnugo",
      "command": "gnugo",
      "parameters": "--mode gtp --japanese-rules",
      "main": 1
