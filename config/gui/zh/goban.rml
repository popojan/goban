<rml>
<head>
	<link type="text/css" href="../base.rcss"/>
	<link type="text/css" href="fonts.rcss"/>
	<title>Window</title>
</head>
<body id="game_window">
    <game id="game" onmousedown="mdown" onmouseup="mup">
        <div class="menu hoverable top right">
            <div class="menu show">
                <div class="menuitem hoverable left">
                    <span>文件</span>
                    <div class="menuitem show">
                        <div class="grp">
                            <div class="hr">SGF</div>
                            <div class="cmd" onmouseup="load">加载棋谱...</div>
                            <div class="cmd" id="cmdSave" onmouseup="save">保存棋谱</div>
                            <div class="cmd" onmouseup="archive">归档</div>
                        </div>
                        <div class="grp">
                            <div class="hr">对局</div>
                            <div class="cmd" id="cmdPrevGame" onmouseup="prev_game">上一局</div>
                            <div class="cmd" id="cmdNextGame" onmouseup="next_game">下一局</div>
                        </div>
                        <div class="grp">
                            <div class="hr">系统</div>
                            <div class="cmd" onmouseup="quit">退出</div>
                        </div>
                    </div>
                </div>
                <div class="menuitem hoverable left">
                    <span>显示方式</span>
                    <div class="menuitem show">
                        <div class="grp">
                            <div class="hr">外观</div>
                            <div class="cmd">
                                <select id="selectShader"
                                        onchange="shader" onmousedown="nop"/>
                            </div>
                        </div>
                        <div class="grp">
                            <div class="hr">窗口</div>
                            <div class="cmd toggle_fullscreen unselected" id="cmdFullscreen" onmouseup="toggle_fullscreen">全屏</div>
                        </div>
                        <div class="grp">
                            <div class="hr">标注</div>
                            <div class="cmd toggle_last_move_overlay selected" id="cmdLastMoveOverlay" onmouseup="toggle_last_move_overlay">上一手</div>
                            <div class="cmd toggle_next_move_overlay selected" id="cmdNextMoveOverlay" onmouseup="toggle_next_move_overlay">下一手</div>
                            <div class="cmd toggle_evaluation_moves unselected" id="cmdEvaluationMoves" onmouseup="toggle_evaluation_moves">推荐手</div>
                            <div class="cmd toggle_evaluation_board unselected" id="cmdEvaluationBoard" onmouseup="toggle_evaluation_board">盘上胜率</div>
                            <div class="cmd toggle_coordinates unselected" id="cmdCoordinates" onmouseup="toggle_coordinates">坐标</div>
                        </div>
                        <!--
                        <div class="grp">
                            <div class="hr">Gamma correction</div>
                            <div class="cmd" onmouseup="reset gamma and contrast">Reset gamma</div>
                        </div>
                        <div class="grp">
                            <div class="hr">Contrast</div>
                            <div class="cmd" onmouseup="reset gamma and contrast">Reset contrast</div>
                        </div>
                        -->
                        <div class="grp">
                            <div class="hr">视角</div>
                            <!--<div class="cmd" onmouseup="free camera toggle">Toggle free</div>-->
                            <div class="cmd" onmouseup="reset camera">复位</div>
                            <div class="cmd" onmouseup="animate">播放动画</div>
                            <div class="cmd" onmouseup="zoom stones">聚焦棋子</div>
                            <div class="hr">视角预设</div>
                            <div class="cmd" onmouseup="save camera">保存</div>
                            <div class="cmd" onmouseup="delete camera">还原</div>
                        </div>
                    </div>
                </div>
                <div class="menuitem hoverable left">
                    <span>游戏</span>
                    <div class="menuitem show">
                        <div class="grp">
                            <div class="hr">黑棋</div>
                            <div class="cmd toggle_black_player unselected">
                                <select id="selectBlack"
                                        onchange="engine" onmousedown="nop"/>
                            </div>
                            <div class="hr">白棋</div>
                            <div class="cmd toggle_white_player unselected">
                                <select id="selectWhite" onchange="engine" onmousedown="nop"/>
                            </div>
                            <div class="hr">棋盘大小</div>
                            <div class="cmd">
                                <select id="selBoard"
                                        onmousedown="nop" onchange="boardsize">
                                    <!--better use × if font allows -->
                                    <option value="19" selected>19×19</option>
                                    <option value="17">17×17</option>
                                    <option value="15">15×15</option>
                                    <option value="13">13×13</option>
                                    <option value="11">11×11</option>
                                    <option value="9">9×9</option>
                                </select>
                            </div>
                            <div class="hr">贴目</div>
                            <div class="cmd">
                                <select id="selectKomi"
                                        onmousedown="nop" onchange="komi">
                                    <option value="0.5">0.5</option>
                                    <option value="6.5">6.5</option>
                                    <option value="7.5" selected>7.5</option>
                                </select>
                            </div>
                            <div class="hr">让子棋</div>
                            <div class="cmd">
                                <select id="selectHandicap"
                                        onchange="handicap" onmousedown="nop">
                                    <option value="0" selected>不让子</option>
                                    <option value="2">让2子</option>
                                    <option value="3">让3子</option>
                                    <option value="4">让4子</option>
                                    <option value="5">让5子</option>
                                    <option value="6">让6子</option>
                                    <option value="7">让7子</option>
                                    <option value="8">让8子</option>
                                    <option value="9">让9子</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="menuitem hoverable left">
                    <span>落子</span>
                    <div class="menuitem show">
                        <div class="grp">
                            <div id="grpGame">
                            <div class="hr">游戏</div>
                            <div class="cmd" id="cmdStart" onmouseup="start">开始</div>
                            <div class="cmd" id="cmdClear" onmouseup="clear">清除</div>
                            <div class="template" id="templateResignWhiteWon">白中盘胜</div>
                            <div class="template" id="templateResignBlackWon">黑中盘胜</div>
                            <div class="template" id="templateWhiteWon">白胜%.1f目</div>
                            <div class="template" id="templateBlackWon">黑胜%.1f目</div>
                            <div class="template" id="templateWhiteResigns">白方认输</div>
                            <div class="template" id="templateBlackResigns">黑方认输</div>
                            <div class="template" id="templateWhitePasses">({0}) 白方虚着</div>
                            <div class="template" id="templateBlackPasses">({0}) 黑方虚着</div>
                            <div class="template" id="templateCalculatingScore">计算得分中...</div>
                            <div class="template" id="templateClearBoard">清空棋盘？</div>
                            <div class="template" id="templateQuitWithoutFinishing">退出未完成的对局？</div>
                            <div class="template" id="templateStartNewGame">开始新对局？</div>
                            </div>
                            <div id="grpMoves">
                            <div class="hr">落子</div>
                            <div class="cmd" id="cmdPass" onmouseup="pass">停一手</div>
                            <div class="cmd" id="cmdKibitz" onmouseup="play once">提示</div>
                            <div class="cmd" id="cmdUndo" onmouseup="undo move">悔棋</div>
                            <div class="cmd" id="cmdResign" onmouseup="resign">认输</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="menuitem hoverable left">
                    <span>分析</span>
                    <div class="menuitem show">
                        <div class="grp">
                            <div class="hr">模式</div>
                            <div class="cmd toggle_analysis_mode unselected" id="cmdAnalysisMode" onmouseup="toggle_analysis_mode">分析模式</div>
                        </div>
                        <div class="grp" id="grpReplay">
                            <div class="hr">回放</div>
                            <div class="cmd" id="cmdNavStart" onmouseup="navigate_start">第一手</div>
                            <div class="cmd" id="cmdNavBack" onmouseup="navigate_back">上一手</div>
                            <div class="cmd" id="cmdNavForward" onmouseup="navigate_forward">下一手</div>
                            <div class="cmd" id="cmdNavEnd" onmouseup="navigate_end">最后一手</div>
                        </div>
                        <div class="grp">
                            <div class="hr">得分</div>
                            <div class="cmd toggle_territory unselected" id="cmdTerritory" onmouseup="toggle_territory">形势判断</div>
                            <div class="cmd toggle_evaluation unselected" id="cmdEvaluation" onmouseup="toggle_evaluation">胜率</div>
                        </div>
                        <div class="grp">
                            <div class="hr">提子</div>
                            <div class="template" id="templatePrisonersWhite">白: %d</div>
                            <div class="template" id="templatePrisonersBlack">黑: %d</div>
                            <div class="cmd" id="lblPrisonersWhite">白: 0</div>
                            <div class="cmd" id="lblPrisonersBlack">黑: 0</div>
                        </div>
                    </div>
                </div>
                <div class="menuitem hoverable right">
                    <span>选项</span>
                    <div class="menuitem show">
                        <div class="grp">
                            <div class="hr">语言</div>
                            <div class="cmd">
                                <select id="selectLanguage" onchange="language" onmousedown="nop">
                                </select>
                            </div>
                        </div>
                        <div class="grp">
                            <div class="hr">声音</div>
                            <div class="cmd toggle_sound selected" id="cmdSound" onmouseup="toggle_sound">声音</div>
                        </div>
                        <div class="grp">
                            <div class="hr">帧率</div>
                            <div class="template" id="templateFPS">%.1f 帧/秒</div>
                            <div class="cmd toggle_fps unselected" id="lblFPS" onmouseup="toggle_fps"></div>
                        </div>
                        <div class="grp">
                            <div class="hr">版本</div>
                            <div class="cmd" id="lblVersion" onmouseup="nop">Goban %s</div>
                            <div class="cmd" onmouseup="toggle_log">消息</div>
                            <div class="cmd" onmouseup="report_bug">报告错误</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div id="grpPlayers">
            <div id="grpBlack" class="hoverable bottom left">
                <div class="show bottom left">
                  <div class="cmd" id="cntBlack" onmouseup="nop">Black: 0</div>
                </div>
            </div>
            <div id="grpWhite" class="hoverable top right">
                <div class="show top right">
                  <div class="cmd" id="cntWhite" onmouseup="nop">White: 0</div>
                </div>
            </div>
        </div>
        <div class="bottom message-container">
            <div class="cmd center" id="lblMessage" onmouseup="msg"></div>
        </div>
        <!-- Live evaluation (ADR-0007). A third display surface on purpose: it
             carries a value that is continuously *true*, where #lblMessage
             carries things that *happened once*. Placement is one rule in
             base.rcss (#grpAnalysis). -->
        <div id="grpAnalysis" class="hide">
            <div id="barEval"><div id="barEvalFill"></div></div>
            <div id="lblEvalWinrate"></div>
            <div id="lblEvalScore"></div>
        </div>

        <!-- Status indicator and the log behind it. Placement is one rule in
             base.rcss (#grpStatus); nothing here depends on where it sits. -->
        <div id="grpStatus" class="top left">
            <div class="cmd" id="lblStatus" onmouseup="toggle_log"></div>
            <div id="pnlLog" class="hide">
                <div id="lstLog"></div>
                <div class="cmd" id="cmdLogClear" onmouseup="log_clear">清除</div>
            </div>
        </div>
    </game>
    <!-- Mode label templates -->
    <div class="template" id="tplAnalysisMode">分析模式</div>
    <div class="template" id="tplTsumegoMode">诘棋模式</div>
    <div class="template" id="tplTsumegoSolved">解答正确！</div>
    <div class="template" id="tplTsumegoWrong">错误！</div>
    <div class="template" id="tplBlackToMove">黑先</div>
    <div class="template" id="tplWhiteToMove">白先</div>

    <!-- Status indicator templates. %s is the engine name for the loading case,
         and the unseen-message count for the warning and error cases. -->
    <div class="template" id="tplStatusLoading">正在加载 %s…</div>
    <div class="template" id="tplStatusSyncing">正在同步引擎…</div>
    <div class="template" id="tplStatusMessages">× 消息</div>
    <div class="template" id="tplStatusWarning">⚠ 消息 (%d)</div>
    <div class="template" id="tplStatusError">⚠ 消息 (%d)</div>

    <!-- Live evaluation. Everything is in Black's frame of reference:
         engines report for the side to move, so raw numbers flip every
         move and read as noise. -->
    <div class="template" id="tplEvalWinrate">黑 %d%%</div>
    <div class="template" id="tplEvalScoreBlack">黑+%.1f</div>
    <div class="template" id="tplEvalScoreWhite">白+%.1f</div>

    <!-- Status and command feedback -->
    <div class="template" id="templateKomi">贴目: %.1f</div>
    <div class="template" id="templateHandicap">让子: %d</div>
    <div class="template" id="tplWaitingFor">正在等待 %s...</div>
    <div class="template" id="tplSaveFailed">保存失败: %s</div>
    <div class="template" id="tplNothingToSave">没有可保存的内容</div>
    <div class="template" id="tplNothingRecorded">尚无记录</div>
    <div class="template" id="tplNothingToArchive">没有可存档的内容</div>
    <div class="template" id="tplArchiveFailed">存档失败</div>
    <div class="template" id="tplScoringFailed">计分失败: %s</div>
    <div class="template" id="tplAnalysisAnswersEveryMove">分析模式会回应每一手 — 对局中请使用形势判断</div>
    <div class="template" id="tplResignAtEndOnly">请移动到棋局末尾才能认输</div>
    <div class="template" id="tplKomiBeforePlayOnly">贴目只能在开局前修改</div>

    <!-- Message templates -->
    <div class="template" id="tplMessage"><span class="dismissable">%MSG%</span></div>
    <div class="template" id="tplPromptYesNo">%MSG% <span class="prompt-btn" onmouseup="prompt_yes">是</span> <span class="prompt-btn" onmouseup="prompt_no">否</span></div>
    <div class="template" id="tplPromptOkCancel">%MSG% <span class="prompt-btn" onmouseup="prompt_ok">确定</span> <span class="prompt-btn" onmouseup="prompt_cancel">取消</span></div>
</body>
</rml>
