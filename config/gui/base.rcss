/* Shared base styles for all languages */

body, html
{
  width: 100%;
  height: 100%;
  font-weight: normal;
  font-style: normal;
  font-size: 25pt;
  color: #ffffff80;
  background-color: #000;
  border-width:0px;
  border-color:#ffffffa0;
  padding: 0px;
  margin: 0px;
  z-index: -1;
  white-space: nowrap;
  overflow: visible;
}

/* Game element fills entire window */
game {
  display: block;
  width: 100%;
  height: 100%;
  left: 0px;
  top: 0px;
  position: absolute;
}

/* Menu bar at top - hidden by default, shows on hover */
.menu {
  width: 100%;
  height: 2rem;
  position: absolute;
  top: 0px;
  left: 0px;
  z-index: 100;
}

/* Menu bar items (File, View, Game, etc.) */
.menuitem.hoverable {
  display: inline-block;
  position: relative;
  padding: 0.2rem 0.5rem;
  color: #ffffffa0;
}

.menuitem.hoverable.left {
  float: left;
}

.menuitem.hoverable.right {
  float: right;
}

.menuitem.hoverable:hover {
  background-color: #00000040;
  color: #ffffffff;
}

/* Menu item label - hidden by default, shown on hover */
.menu span {
  display: none;
  padding-right: 0.25rem;
}

.menu.hoverable:hover span {
  display: inline-block;
}

/* Dropdown menus - hidden by default, positioned below parent */
.menuitem.show {
  display: none;
  position: absolute;
  top: 1.6rem;
  left: 0px;
  width: 9.9rem;
  background-color: #00000040;
  padding: 0.25rem;
  z-index: 200;
  overflow: hidden;
}

/* Right-aligned menu dropdowns */
.menuitem.hoverable.right .menuitem.show {
  left: auto;
  right: 0px;
}

/* Show dropdown on hover */
.menuitem.hoverable:hover .menuitem.show {
  display: block;
}

/* Command items in dropdowns */
div.cmd {
  display: block;
  height: 1.25rem;
  color: #ffffff80;
  border-right: 0.2rem #ffffff00;
}

div.cmd:hover {
  color: #fffffff0;
}

/* Disabled state - grayed out, no hover effect */
div.cmd.disabled {
  color: #ffffff30;
  pointer-events: none;
}

div.cmd.disabled:hover {
  color: #ffffff30;
}

/* Section headers in dropdowns */
div.hr {
  display: block;
  margin-top: 0.5rem;
  margin-bottom: 0.15rem;
  font-size: 0.6rem;
  color: #ffffff60;
}

/* Group containers */
div.grp {
  display: block;
}

/* Select dropdowns */
select {
  display: block;
  width: 100%;
}

select option {
  color: #ffffff80;
}

select option:hover {
  color: #fffffff0;
}

select selectbox {
  width: auto;
  min-width: 10rem;
  position: absolute;
  left: 100%;
  top: 0px;
  margin-left: 0.45rem;
  padding: 0.25rem;
  background-color: #00000040;
}

/* Right-aligned menu: selectbox opens to the left */
.menuitem.hoverable.right select selectbox {
  left: auto;
  right: 100%;
  margin-left: 0.0rem;
  margin-right: 0.25rem;
}

/* Templates - hidden always */
div.template {
  display: none;
}

/* Bottom status area - prisoner counts hidden (now in Analyze menu) */
#grpPlayers {
  display: none;
}

#cntBlack {
  display: none;
}

#cntWhite {
  display: none;
}

#lblMessage {
  display: block;
  text-align: center;
  padding: 0.25rem;
  white-space: pre-wrap;
  height: 30%;
  overflow: auto;
}
#lblMessage:hover {
  color: #ffffff80;  /* No hover on container - children handle their own */
}

/* Dismissable messages show hover to indicate clickability */
.dismissable:hover {
  color: #fffffff0;
}

/* Prompt buttons in lblMessage (aligned with .button in open.rcss) */
.prompt-btn {
  display: inline-block;
  padding: 0.3rem 0.8rem;
  margin: 0 0.25rem;
}
.prompt-btn:hover {
  color: #fffffff0;
}

/* Status indicator and log panel.
 *
 * Everything about where this lives is here, in #grpStatus — move that one rule
 * and the badge and its panel move together. Top left is simply the corner the
 * menu (top right), the prisoner counts (bottom left / top right) and the
 * message box (bottom, full width) do not already use.
 *
 * The indicator is deliberately not a toast. A message that fades is no better
 * than a log file nobody opens, and engine failures land in the first seconds
 * of a session — so this stays up until the user has looked at it.
 */
#grpStatus {
  position: absolute;
  top: 2rem;        /* clears .menu, which is a full-width 2rem strip at top: 0 */
  left: 0px;
  /* A definite width, not max-width: absolutely positioned with only `left`
     set, the box shrink-wraps, and log lines then wrap to about one character
     each. */
  width: 40%;
  z-index: 2;       /* below .menu (100) so its dropdowns still draw over this */
}
#lblStatus {
  display: none;             /* shown only while loading, or with unseen messages */
  padding: 0.25rem 0.5rem;
  /* Its own backing, for two reasons: over a lit wooden board and a bowl of
     white stones, coloured text alone is unreadable; and when the panel is open
     this is its header, so the two must read as one surface. */
  background-color: #000000b0;
}
#lblStatus.loading { display: block; color: #ffffffa0; }
#lblStatus.warning { display: block; color: #ffd080f0; }
#lblStatus.error   { display: block; color: #ff9090f0; }
/* Shown whenever the panel is open, whatever the badge would otherwise say:
   it is the only close affordance the panel has. */
#lblStatus.open    { display: block; color: #ffffffa0; font-size: 11pt; }
#lblStatus:hover { color: #fffffff0; }

#pnlLog {
  padding: 0.25rem;
  max-height: 40%;
  overflow: auto;
  /* Opaque enough to read engine output over a lit wooden board. The menus use
     #00000040, but they are short labels and this is dense diagnostic text. */
  background-color: #000000b0;
}
#lstLog {
  display: block;
  white-space: pre-wrap;
  /* The body is 25pt, sized for menu labels read at a glance. Diagnostics are
     dense and read deliberately, so they get their own size rather than
     inheriting one chosen for something else. */
  font-size: 11pt;
  line-height: 1.3;
}
#lstLog .log-info    { display: block; color: #ffffff80; }
#lstLog .log-warning { display: block; color: #ffd080d0; }
#lstLog .log-error   { display: block; color: #ff9090e0; }
#cmdLogClear {
  font-size: 11pt;    /* matches #lstLog; the 25pt body size is for menu labels */
  height: auto;
  padding-top: 0.25rem;
}

/* Positioning utilities */
.bottom { position: absolute; bottom: 0px; left: 0px; right: 0px; }

/* Message container */
.message-container {
}
.left { position: absolute; left: 0px; }
.center { text-align: center; }
.right { position: absolute; right: 0px; }
.top { position: absolute; top: 0px; }

/* Combined positioning classes */
.top.right { position: absolute; top: 0px; right: 0px; }
.top.left { position: absolute; top: 0px; left: 0px; }
.bottom.right { position: absolute; bottom: 0px; right: 0px; }
.bottom.left { position: absolute; bottom: 0px; left: 0px; }

/* State indicators */
div.selected {
  border-right: 0.2rem #ffffff80;
}
div.unselected {
  border-right: 0.2rem #ffffff20;
}

/* Hide/Show utilities */
div.hide { display: none; }
div.show { display: block; }
